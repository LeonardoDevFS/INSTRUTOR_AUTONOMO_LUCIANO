NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Página pública de Agendamento de Horários do Google Agenda
# Aceita somente uma URL oficial https://calendar.google.com/... ou https://calendar.app.google/...
NEXT_PUBLIC_GOOGLE_BOOKING_URL=

# Painel administrativo — nunca use NEXT_PUBLIC_ nestas variáveis
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_ALLOWED_EMAIL=instrutorautonomoluciano@gmail.com
GOOGLE_CALENDAR_ID=instrutorautonomoluciano@gmail.com
APP_TIMEZONE=America/Sao_Paulo

# Agendamento personalizado — Supabase Transaction Pooler, porta 6543
# Copie a URI em Supabase > projeto > Connect > Transaction pooler
# Valor privado, terminado em :6543/postgres?sslmode=verify-full
CUSTOM_BOOKING_ENABLED=false
DATABASE_URL=
# Opcional: caminho local da CA oficial do Supabase, fora de public/
SUPABASE_CA_CERT_PATH=
# Alternativa para produção, somente se a cadeia padrão falhar: PEM oficial completo
SUPABASE_CA_CERT_PEM=
GOOGLE_CALENDAR_REFRESH_TOKEN=
BOOKING_MIN_ADVANCE_MINUTES=
BOOKING_MAX_ADVANCE_DAYS=
BOOKING_BUFFER_MINUTES=0
# Datas sem atendimento, separadas por vírgula: 2026-12-25,2027-01-01
BOOKING_CLOSED_DATES=

# Google Analytics
NEXT_PUBLIC_GA_ID=
